# Local development env. AppAPI injects these in production.
APP_ID=bee_flow_ai
APP_SECRET=dev-secret
APP_VERSION=0.1.0
APP_PORT=9000
NEXTCLOUD_URL=http://localhost:8080

# Customer-configured in prod via `occ app_api:app:setenv bee_flow_ai ...`
BEEFLOW_TENANT_KEY=dev-tenant-key
BEEFLOW_API_BASE_URL=http://localhost:3101

# Extra origins allowed to embed the app in an iframe (comma-separated), on top
# of NEXTCLOUD_URL and BEEFLOW_NC_PUBLIC_URL. Needed only when the browser
# reaches Nextcloud on an origin the connector never sees — a reverse proxy in
# front of NC, or a dev box where NEXTCLOUD_URL is http://host.docker.internal
# while the browser is on http://localhost. Symptom of a missing entry: the
# embedded app stays blank and the browser console reports a frame-ancestors
# violation; the connector also logs the exact origin to add.
# BEEFLOW_TRUSTED_EMBED_ORIGINS=http://localhost:8080
