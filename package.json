{
  "name": "bee-flow-connector",
  "version": "1.6.7",
  "private": true,
  "description": "Nextcloud ExApp connector for Bee Flow — proxies authenticated requests from a customer's Nextcloud to the hosted Bee Flow SaaS.",
  "license": "AGPL-3.0-or-later",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 node --test test/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=22.15.0 <23.0.0"
  },
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-static": "^1.61.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "7.0.2"
  }
}
